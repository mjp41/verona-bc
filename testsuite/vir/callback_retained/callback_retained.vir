// A retained callback remains valid after managed handles are dropped.
// Native code receives the callable code pointer and opaque release handle.
// Expected exit code: 0.

lib
  @call_fn_ptr_ret_u64 = "call_fn_ptr_ret_u64"(ptr, u64): u64
  @set_exit_code = "set_exit_code"(i32): none

class @Callable
  @offset: u64
  @callback @callable_apply

func @callable_apply($self: @Callable, $value: u64): u64
  $offset_ref = ref $self @offset
  $offset = load $offset_ref
  $result = add $value $offset
  ret $result

func @main(): none
  $ten = const u64 10
  $callable = new @Callable($ten)
  $callback = makecallback $callable
  $code = codeptrcallback $callback
  $handle = retaincallback $callback
  drop $callback

  $thirty_two = const u64 32
  $actual = ffi @call_fn_ptr_ret_u64($code, $thirty_two)
  $_released = releasecallback $handle

  $expected = const u64 42
  $ok = eq $actual $expected
  cond $ok ^success ^failure

^success
  $_none = const none
  ret $_none

^failure
  $one = const i32 1
  $_exit = ffi @set_exit_code($one)
  $_none = const none
  ret $_none
