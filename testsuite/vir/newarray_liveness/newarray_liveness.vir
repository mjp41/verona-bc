lib
  @set_exit_code = "set_exit_code"(i32): none

func @main(): none
  $dynamic_size = const usize 4
  $dynamic_array = new [i32] $dynamic_size
  $dynamic_len = len $dynamic_array
  $dynamic_expected = const usize 4
  $dynamic_ok = eq $dynamic_len $dynamic_expected

  $const_array = new [i32] 7
  $const_len = len $const_array
  $const_expected = const usize 7
  $const_ok = eq $const_len $const_expected

  $all_ok = and $dynamic_ok $const_ok
  cond $all_ok ^pass ^fail
^pass
  $r = const i32 0
  $_ = ffi @set_exit_code($r)
  $_none = const none
  ret $_none
^fail
  $r = const i32 -1
  $_ = ffi @set_exit_code($r)
  $_none = const none
  ret $_none
