lib
  @set_exit_code = "set_exit_code"(i32): none

class @A 
    @f : @B

class @B 
    @f : bool 

class @C 
    @f : @A

func @main(): none 
    $true = const bool true 
    $b = new @B($true)
    $a1 = new @A($b)
    $a2 = new @A($b)
    $c = new @C($a1)
    $field_ref = ref $c @f
    // Replace the shared graph edge through a field reference.
    $old = store $field_ref $a2 

    $ret_val = const i32 42 
    $_ = ffi @set_exit_code($ret_val)
    $_none = const none
    ret $_none
